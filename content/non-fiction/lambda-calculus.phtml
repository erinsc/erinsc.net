                <option value="λx y.x">λx y.x</option>
                <option value="λa b.a b a">λx y.x x y</option>
                <option value="(λc.c c) (λd.d)">(λc.c c) (λd.d)</option>
                <option value="(λn f x.n f (f x)) (λf x.x)">(λn f x.n f (f x)) (λf x.x)</option>
            </select>
        </div>
